<Window x:Class="ClickForge.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClickForge.UI"
        Title="ClickForge" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}">
    <Window.Resources>
        <local:SectionVisibilityConverter x:Key="SectionVisibility"/>
        <local:OptionLabelConverter x:Key="OptionLabel"/>
        <local:MatchingOptionVisibilityConverter x:Key="MatchingOption"/>
        <DataTemplate x:Key="LocalizedOption"><TextBlock Text="{Binding Converter={StaticResource OptionLabel}}"/></DataTemplate>
        <local:StateBrushConverter x:Key="StateBrush"/>
        <SolidColorBrush x:Key="Panel" Color="#121927"/>
        <SolidColorBrush x:Key="ButtonSurface" Color="#263148"/>
        <SolidColorBrush x:Key="Canvas" Color="#0B0F17"/>
        <SolidColorBrush x:Key="Ink" Color="#E8ECF4"/>
        <SolidColorBrush x:Key="Inset" Color="#0E1420"/>
        <SolidColorBrush x:Key="Outline" Color="#2A3650"/>
        <SolidColorBrush x:Key="Muted" Color="#A9B3C7"/>
        <SolidColorBrush x:Key="Hero" Color="#18193B"/>
        <SolidColorBrush x:Key="Tint" Color="#A9A1FF"/>
        <SolidColorBrush x:Key="DangerInk" Color="#FF7D87"/>
        <SolidColorBrush x:Key="Accent" Color="#6D5DFB"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{DynamicResource ButtonSurface}"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.9"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Inset}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Outline}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,5"/></Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Inset}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Outline}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" CornerRadius="6"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Muted}" StrokeThickness="1.4"
                                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Outline}" BorderThickness="1"
                                        CornerRadius="6" Padding="3" Margin="0,3,0,0" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Option" Background="Transparent" Padding="8,5" CornerRadius="4"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Option" Property="Background" Value="{DynamicResource Inset}"/></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="0,10"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,14,14"/></Style>
        <Style x:Key="Nav" TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavSurface" Background="Transparent" CornerRadius="6"
                                BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource Panel}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavSurface" Property="BorderBrush" Value="{DynamicResource Outline}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource Inset}" Padding="18">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="4,8,4,26"><TextBlock Text="CLICKFORGE" FontSize="22" FontWeight="Bold"/><TextBlock Text="AUTOMATION STUDIO" Foreground="{DynamicResource Accent}" FontSize="10" Margin="0,3"/></StackPanel>
                <ListBox Grid.Row="1" Style="{StaticResource Nav}" SelectedIndex="{Binding SelectedSection}">
                    <ListBoxItem>⌂  Главная</ListBoxItem><ListBoxItem>●  Автокликер</ListBoxItem><ListBoxItem>⌖  Мультикликер</ListBoxItem><ListBoxItem>▥  Статистика</ListBoxItem><ListBoxItem>⚙  Настройки</ListBoxItem><ListBoxItem>ⓘ  Помощь</ListBoxItem>
                </ListBox>
                <StackPanel Grid.Row="2">
                    <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Оформление" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ThemePicker" Margin="0,0,0,4" SelectionChanged="AppearanceChanged" AutomationProperties.Name="Тема"/>
                            <ComboBox x:Name="AccentPicker" Margin="0" SelectionChanged="AppearanceChanged" AutomationProperties.Name="Акцентный цвет"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="Горячие клавиши" FontWeight="SemiBold"/><TextBlock Text="{Binding StartGesture, StringFormat={}{0}  Старт / стоп}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/><TextBlock Text="F7  Пауза" Foreground="{DynamicResource Muted}"/><TextBlock Text="F10  Экстренный стоп" Foreground="{DynamicResource DangerInk}"/></StackPanel></Border>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="28,22,24,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Панель управления" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Локальная автоматизация Windows" Foreground="{DynamicResource Muted}" Margin="0,4,0,20"/></StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource Panel}" CornerRadius="18" Padding="15,8" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="{Binding Snapshot.State, Converter={StaticResource StateBrush}}" Margin="0,0,8,0"/><TextBlock Text="{Binding StatusText}" FontWeight="Bold"/></StackPanel></Border>
            </Grid>

            <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Dashboard -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=0}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Background="{DynamicResource Hero}"><StackPanel><TextBlock Text="ЦЕНТР УПРАВЛЕНИЯ" Foreground="{DynamicResource Tint}" FontWeight="Bold"/><TextBlock Text="Готовы к запуску?" FontSize="28" FontWeight="SemiBold" Margin="0,14,0,4"/><TextBlock Text="Автокликер работает в фоне и мгновенно останавливается по F10." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><Button Content="{Binding StartText}" Command="{Binding StartStopCommand}" Background="{DynamicResource Accent}" FontWeight="Bold" FontSize="16" Margin="0,24,0,4" Padding="20,15"/><Button Content="ПАУЗА / ПРОДОЛЖИТЬ" Command="{Binding PauseCommand}"/></StackPanel></Border>
                            <StackPanel Grid.Column="1"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="КЛИКИ ЗА ЗАПУСК" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Snapshot.Clicks}" FontSize="32" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ФАКТИЧЕСКИЙ CPS" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Snapshot.ActualCps, StringFormat={}{0:F1}}" FontSize="32" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ВРЕМЯ РАБОТЫ" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Snapshot.Elapsed, StringFormat={}{0:hh\\:mm\\:ss}}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border></StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Текущий профиль" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Settings.ActiveProfile}" FontSize="17"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Интервал" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Settings.Clicker.IntervalMs, StringFormat={}{0} мс}" FontSize="17"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Горячая клавиша" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding StartGesture}" FontSize="17"/></StackPanel></Grid></Border>
                    </StackPanel>

                    <!-- Clicker -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=1}">
                        <TextBlock Text="Автокликер" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ДЕЙСТВИЕ" FontWeight="Bold" Foreground="{DynamicResource Tint}"/><TextBlock Text="Кнопка мыши" Margin="0,14,0,0"/><ComboBox AutomationProperties.Name="Кнопка мыши" ItemTemplate="{StaticResource LocalizedOption}" ItemsSource="{Binding MouseButtons}" SelectedItem="{Binding Settings.Clicker.Button}"/><TextBlock Text="Тип клика"/><ComboBox AutomationProperties.Name="Тип клика" ItemTemplate="{StaticResource LocalizedOption}" ItemsSource="{Binding ClickTypes}" SelectedItem="{Binding Settings.Clicker.ClickType}"/><TextBlock Text="Длительность удержания, мс"/><TextBox Text="{Binding Settings.Clicker.HoldDurationMs, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="ТАЙМИНГ" FontWeight="Bold" Foreground="{DynamicResource Tint}"/><TextBlock Text="Интервал, мс" Margin="0,14,0,0"/><TextBox Text="{Binding Settings.Clicker.IntervalMs, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Случайный интервал" IsChecked="{Binding Settings.Clicker.UseRandomInterval}"/><StackPanel Visibility="{Binding Settings.Clicker.UseRandomInterval, Converter={StaticResource MatchingOption}, ConverterParameter=True}"><TextBlock Text="Максимальная задержка, мс"/><TextBox AutomationProperties.Name="Максимальная задержка, мс" Text="{Binding Settings.Clicker.RandomMaxMs, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><TextBlock Text="Меньше мс — быстрее. Удержание кнопки добавляется к задержке." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ПОЗИЦИЯ" FontWeight="Bold" Foreground="{DynamicResource Tint}"/><ComboBox AutomationProperties.Name="Позиция курсора" ItemTemplate="{StaticResource LocalizedOption}" ItemsSource="{Binding PositionModes}" SelectedItem="{Binding Settings.Clicker.PositionMode}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox AutomationProperties.Name="Координата X" Text="{Binding Settings.Clicker.X}"/><TextBox Grid.Column="1" AutomationProperties.Name="Координата Y" Text="{Binding Settings.Clicker.Y}" Margin="8,5,0,5"/></Grid><Button Content="Выбрать позицию через 3 секунды" Command="{Binding CapturePositionCommand}"/><TextBlock Text="После нажатия наведите курсор на нужное место." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="ПОВТОРЕНИЕ" FontWeight="Bold" Foreground="{DynamicResource Tint}"/><ComboBox AutomationProperties.Name="Режим повтора" ItemTemplate="{StaticResource LocalizedOption}" ItemsSource="{Binding RepeatModes}" SelectedItem="{Binding Settings.Clicker.RepeatMode}"/><StackPanel Visibility="{Binding Settings.Clicker.RepeatMode, Converter={StaticResource MatchingOption}, ConverterParameter=Count}"><TextBlock Text="Количество повторений"/><TextBox AutomationProperties.Name="Количество повторений" Text="{Binding Settings.Clicker.RepeatCount}"/></StackPanel><StackPanel Visibility="{Binding Settings.Clicker.RepeatMode, Converter={StaticResource MatchingOption}, ConverterParameter=Duration}"><TextBlock Text="Длительность, секунды"/><TextBox AutomationProperties.Name="Длительность, секунды" Text="{Binding Settings.Clicker.DurationSeconds}"/></StackPanel><Button Content="{Binding StartText}" Command="{Binding StartStopCommand}" Background="{DynamicResource Accent}"/></StackPanel></Border>
                        </Grid>
                    </StackPanel>

                    <!-- Multiclicker -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=2}">
                        <DockPanel Margin="0,0,14,16"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Мультикликер" FontSize="24" FontWeight="SemiBold"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="+ Добавить текущую точку" Command="{Binding AddStepCommand}" Margin="6,0"/><Button Content="▶ Выполнить 1 цикл" Command="{Binding StartSequenceCommand}" Background="{DynamicResource Accent}"/></StackPanel></DockPanel>
                        <TextBlock Text="Добавьте точку, укажите X и Y и задайте задержку в миллисекундах. Точки выполняются сверху вниз." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,14,12"/>
                        <ItemsControl ItemsSource="{Binding Steps}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Enabled}"/><TextBox Grid.Column="1" Text="{Binding Name}"/><TextBox Grid.Column="2" Text="{Binding X}" Margin="6,5"/><TextBox Grid.Column="3" Text="{Binding Y}" Margin="6,5"/><TextBox Grid.Column="4" Text="{Binding DelayAfterMs}" Margin="6,5"/><Button Grid.Column="5" Content="Удалить" Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#512B3A" Margin="6,4"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>

                    <!-- Stats -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=3}"><TextBlock Text="Статистика" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/><WrapPanel><Border Style="{StaticResource Card}" Width="270"><StackPanel><TextBlock Text="ВСЕГО КЛИКОВ" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding TotalClicks}" FontSize="38" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="270"><StackPanel><TextBlock Text="ПОСЛЕДНИЙ ЗАПУСК" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Snapshot.Clicks}" FontSize="38" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="270"><StackPanel><TextBlock Text="СРЕДНИЙ CPS" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Snapshot.ActualCps, StringFormat={}{0:F2}}" FontSize="38" FontWeight="Bold"/></StackPanel></Border></WrapPanel><Button Content="Очистить локальную статистику" Command="{Binding ClearStatisticsCommand}" Width="260" HorizontalAlignment="Left" Background="#512B3A"/></StackPanel>

                    <!-- Settings -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=4}">
                        <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Горячая клавиша" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Назначьте клавишу или боковую кнопку мыши для запуска и остановки." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Кнопка запуска / остановки"/><ComboBox x:Name="StartKeyPicker" SelectionChanged="StartKeySelectionChanged" AutomationProperties.Name="Кнопка запуска / остановки"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Число нажатий"/><ComboBox x:Name="StartPressCountPicker" AutomationProperties.Name="Число нажатий для запуска / остановки"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Для своей кнопки выберите «Ввести кнопку самому…» и нажмите её в этом окне. Двойное нажатие: два раза подряд за 300 мс." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,8"/>
                                <Button Content="Применить клавишу" Click="ApplyStartKey" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Профиль и данные" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="Название активного профиля"/>
                                <TextBox Text="{Binding Settings.ActiveProfile}" AutomationProperties.Name="Название активного профиля"/>
                                <CheckBox Content="Сохранять локальную статистику" IsChecked="{Binding Settings.SaveStatistics}"/>
                                <CheckBox Content="Проверять обновления при запуске" IsChecked="{Binding Settings.CheckUpdatesOnStartup}"/>
                                <WrapPanel>
                                    <Button Content="Сохранить настройки" Command="{Binding SaveCommand}" Background="{DynamicResource Accent}" Margin="0,4,8,4"/>
                                    <Button Content="Проверить обновления" Click="CheckUpdatesClick" Margin="0,4,8,4"/>
                                    <Button Content="Сбросить настройки" Click="ResetSettings" Background="#512B3A"/>
                                </WrapPanel>
                                <TextBlock Text="Сброс восстановит заводские настройки и точки мультикликера. Статистика сохранится." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="HelpPage" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=5}">
                        <TextBlock Text="Помощь" FontSize="24" Margin="0,0,0,18"/>
                        <local:HelpGuide x:Name="Guide"/>
                        <local:FeedbackPanel x:Name="Feedback"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{DynamicResource Panel}" CornerRadius="10" Padding="12,5" Margin="0,8,14,0">
                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" Margin="0,3"/>
            </Border>
        </Grid>
    </Grid>
</Window>
